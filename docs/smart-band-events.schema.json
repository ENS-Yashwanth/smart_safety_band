{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apexfabric.local/schemas/smart-band-events-1.0.json",
  "title": "Smart Band ICCC events",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "correlation_id",
    "event_type",
    "severity",
    "occurred_at",
    "source",
    "location",
    "evidence",
    "payload"
  ],
  "properties": {
    "schema_version": {"const": "smart-city-event/1.0"},
    "event_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "event_type": {"enum": ["device.heartbeat", "sos.triggered", "sos.updated"]},
    "severity": {"enum": ["info", "critical"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "received_at": {"type": "string", "format": "date-time"},
    "source": {"$ref": "#/$defs/source"},
    "location": {"$ref": "#/$defs/location"},
    "evidence": {
      "type": "array",
      "maxItems": 16,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "payload": {"type": "object"}
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "event_type": {"const": "device.heartbeat"},
            "severity": {"const": "info"},
            "correlation_id": {"pattern": "^device:.+"},
            "evidence": {"maxItems": 0},
            "payload": {"$ref": "#/$defs/heartbeatPayload"}
          }
        },
        {
          "properties": {
            "event_type": {"const": "sos.triggered"},
            "severity": {"const": "critical"},
            "evidence": {
              "minItems": 1,
              "contains": {
                "type": "object",
                "properties": {"type": {"const": "audio"}},
                "required": ["type"]
              }
            },
            "payload": {"$ref": "#/$defs/sosTriggeredPayload"}
          }
        },
        {
          "properties": {
            "event_type": {"const": "sos.updated"},
            "severity": {"const": "critical"},
            "evidence": {"maxItems": 0},
            "payload": {"$ref": "#/$defs/sosUpdatedPayload"}
          }
        }
      ]
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_id"],
      "properties": {
        "kind": {"const": "smart-band"},
        "source_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "deployment_id": {"type": ["string", "null"]}
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "site_id", "latitude", "longitude", "accuracy_m"],
      "properties": {
        "kind": {"const": "geo"},
        "site_id": {"type": "string", "minLength": 1},
        "zone_id": {"type": ["string", "null"]},
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "accuracy_m": {"type": "number", "minimum": 0}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "uri", "content_type"],
      "properties": {
        "type": {"const": "audio"},
        "uri": {"type": "string", "pattern": "^https?://"},
        "content_type": {"enum": ["audio/wav", "audio/x-wav", "audio/amr", "audio/amr-wb"]},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "heartbeatPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["band_id", "status", "last_seen", "battery_percent"],
      "properties": {
        "band_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "status": {"enum": ["online", "offline"]},
        "last_seen": {"type": "string", "format": "date-time"},
        "battery_percent": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "sosTriggeredPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["band_id", "trigger", "sos_status", "location_source", "audio"],
      "properties": {
        "band_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "trigger": {"const": "button"},
        "sos_status": {"const": "triggered"},
        "location_source": {"enum": ["gps", "network", "manual", "unknown"]},
        "altitude_m": {"type": ["number", "null"], "minimum": -500, "maximum": 20000},
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence_id", "content_type", "duration_seconds", "size_bytes"],
          "properties": {
            "evidence_id": {"type": "string", "minLength": 1},
            "content_type": {"enum": ["audio/wav", "audio/x-wav", "audio/amr", "audio/amr-wb"]},
            "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
            "size_bytes": {"type": "integer", "minimum": 1, "maximum": 8388608}
          }
        }
      }
    },
    "sosUpdatedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["band_id", "sos_status", "update_type", "sequence", "location_source"],
      "properties": {
        "band_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "sos_status": {"const": "active"},
        "update_type": {"const": "location"},
        "sequence": {"type": "integer", "minimum": 1},
        "location_source": {"enum": ["gps", "network", "manual", "unknown"]},
        "altitude_m": {"type": ["number", "null"], "minimum": -500, "maximum": 20000}
      }
    }
  }
}
