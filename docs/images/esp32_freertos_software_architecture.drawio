<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" modified="2026-08-04" agent="Antigravity AI" version="21.0.0" type="device">
  <diagram id="esp32_software_arch" name="ESP32 Software Architecture">
    <mxGraphModel dx="1400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Main Title -->
        <mxCell id="title" value="ESP32-S3 Smart Safety Band — Software &amp; FreeRTOS Task Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="700" height="40" as="geometry" />
        </mxCell>

        <!-- APPLICATION LAYER CONTAINER -->
        <mxCell id="box_app" value="APPLICATION LAYER (FreeRTOS Concurrent Tasks)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#0369A1;" vertex="1" parent="1">
          <mxGeometry x="150" y="90" width="900" height="180" as="geometry" />
        </mxCell>

        <mxCell id="task_sos" value="manual_sos_task&#10;(Priority 8, Stack 4KB)&#10;Active-Low SOS Handler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontStyle=1;fontSize=11;fontColor=#0C4A6E;strokeWidth=2;" vertex="1" parent="box_app">
          <mxGeometry x="50" y="50" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="task_safety" value="safety_manager_task&#10;(Priority 9, Stack 4KB)&#10;Emergency Latches &amp; Dispatcher" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontStyle=1;fontSize=11;fontColor=#0C4A6E;strokeWidth=2;" vertex="1" parent="box_app">
          <mxGeometry x="340" y="50" width="230" height="90" as="geometry" />
        </mxCell>

        <mxCell id="task_comm" value="communication_task (Modem)&#10;(Priority 10, Stack 4KB)&#10;SIM868 DTE &amp; Diagnostic Engine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontStyle=1;fontSize=11;fontColor=#0C4A6E;strokeWidth=2;" vertex="1" parent="box_app">
          <mxGeometry x="630" y="50" width="230" height="90" as="geometry" />
        </mxCell>

        <!-- SERVICE & QUEUE LAYER CONTAINER -->
        <mxCell id="box_service" value="SERVICE &amp; QUEUE LAYER (Inter-Task Synchronization &amp; Data Passing)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#15803D;" vertex="1" parent="1">
          <mxGeometry x="150" y="380" width="900" height="180" as="geometry" />
        </mxCell>

        <mxCell id="sem_sos" value="s_sos_sem&#10;(Binary Semaphore)&#10;ISR -&gt; Task Notification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontStyle=1;fontSize=11;fontColor=#14532D;strokeWidth=2;" vertex="1" parent="box_service">
          <mxGeometry x="50" y="50" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="queue_events" value="s_safety_events Queue&#10;(Depth 16, safety_event_t)&#10;SOS, Fall, Missing Sensors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontStyle=1;fontSize=11;fontColor=#14532D;strokeWidth=2;" vertex="1" parent="box_service">
          <mxGeometry x="340" y="50" width="230" height="90" as="geometry" />
        </mxCell>

        <mxCell id="group_events" value="s_system_events&#10;(FreeRTOS Event Group)&#10;BIT_MODEM_READY | BIT_EMERGENCY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontStyle=1;fontSize=11;fontColor=#14532D;strokeWidth=2;" vertex="1" parent="box_service">
          <mxGeometry x="630" y="50" width="230" height="90" as="geometry" />
        </mxCell>

        <!-- DRIVER & HW HAL LAYER CONTAINER -->
        <mxCell id="box_hal" value="DRIVER &amp; HW HAL LAYER (Hardware Peripherals &amp; Interrupt Service Routines)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#B45309;" vertex="1" parent="1">
          <mxGeometry x="150" y="670" width="900" height="180" as="geometry" />
        </mxCell>

        <mxCell id="hal_gpio" value="GPIO Driver &amp; ISR&#10;SOS GPIO41 (NegEdge ISR)&#10;Status LED GPIO47, Modem Pwr GPIO42" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;fontSize=11;fontColor=#78350F;strokeWidth=2;" vertex="1" parent="box_hal">
          <mxGeometry x="40" y="50" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="hal_i2c" value="Shared I2C (s_i2c_mutex)&#10;Master I2C 400kHz (SDA=8, SCL=9)&#10;LSM6DSOX / LIS3DH Accelerometer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;fontSize=11;fontColor=#78350F;strokeWidth=2;" vertex="1" parent="box_hal">
          <mxGeometry x="330" y="50" width="250" height="90" as="geometry" />
        </mxCell>

        <mxCell id="hal_uart" value="UART DTE (SIM868 Modem)&#10;UART1 115200 Baud (TX=17, RX=18)&#10;esp_modem AT Command Bridge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;fontSize=11;fontColor=#78350F;strokeWidth=2;" vertex="1" parent="box_hal">
          <mxGeometry x="620" y="50" width="250" height="90" as="geometry" />
        </mxCell>

        <!-- INTER-LAYER CONNECTIONS -->

        <!-- 1. ISR -> s_sos_sem -->
        <mxCell id="e_isr_sem" value="[xSemaphoreGiveFromISR]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=classic;fontStyle=1;fontSize=10;fontColor=#B45309;" edge="1" parent="1" source="hal_gpio" target="sem_sos">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 2. s_sos_sem -> manual_sos_task -->
        <mxCell id="e_sem_task" value="[xSemaphoreTake]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16A34A;strokeWidth=2;endArrow=classic;fontStyle=1;fontSize=10;fontColor=#15803D;" edge="1" parent="1" source="sem_sos" target="task_sos">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 3. manual_sos_task -> s_safety_events Queue -->
        <mxCell id="e_task_queue" value="[xQueueSend EVENT_MANUAL_SOS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0284C7;strokeWidth=2;endArrow=classic;fontStyle=1;fontSize=10;fontColor=#0369A1;" edge="1" parent="1" source="task_sos" target="queue_events">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="310" y="310" />
              <mxPoint x="430" y="310" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 4. s_safety_events Queue -> safety_manager_task -->
        <mxCell id="e_queue_safety" value="[xQueueReceive]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16A34A;strokeWidth=2;endArrow=classic;fontStyle=1;fontSize=10;fontColor=#15803D;" edge="1" parent="1" source="queue_events" target="task_safety">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 5. safety_manager_task -> Direct Task Notification -> communication_task -->
        <mxCell id="e_safety_notify" value="[xTaskNotifyGive Direct Notify]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0284C7;strokeWidth=2;endArrow=classic;fontStyle=1;fontSize=10;fontColor=#0369A1;" edge="1" parent="1" source="task_safety" target="task_comm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 6. safety_manager_task -> s_system_events -->
        <mxCell id="e_safety_group" value="[xEventGroupSetBits BIT_EMERGENCY]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0284C7;strokeWidth=2;endArrow=classic;fontStyle=1;fontSize=10;fontColor=#0369A1;" edge="1" parent="1" source="task_safety" target="group_events">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="500" y="310" />
              <mxPoint x="715" y="310" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 7. communication_task -> UART DTE -->
        <mxCell id="e_comm_uart" value="[esp_modem DTE Commands]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0284C7;strokeWidth=2;endArrow=classic;fontStyle=1;fontSize=10;fontColor=#0369A1;" edge="1" parent="1" source="task_comm" target="hal_uart">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="880" y="310" />
              <mxPoint x="880" y="610" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 8. Shared I2C -> s_safety_events Queue (Motion/Fall Event) -->
        <mxCell id="e_i2c_queue" value="[publish_event EVENT_FALL]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=classic;fontStyle=1;fontSize=10;fontColor=#B45309;" edge="1" parent="1" source="hal_i2c" target="queue_events">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
