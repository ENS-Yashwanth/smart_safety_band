menu "Smart Safety Band configuration"

    config SAFETY_BAND_SOS_GPIO
        int "SOS push-button GPIO"
        range 0 48
        default 4
        help
            GPIO wired to the emergency push button. The reference design uses
            an active-low button with the internal pull-up enabled.

    config SAFETY_BAND_MOTION_INT_GPIO
        int "Motion interrupt GPIO"
        range 0 48
        default 2
        help
            Reserved for the accelerometer interrupt on the GL868 reference
            board. The current motion task polls at 20 ms.

    config SAFETY_BAND_SIMULATION
        bool "Simulate missing health and environment sensors"
        default n
        help
            Allows real-time firmware development before optional modules are
            available. The real accelerometer is always preferred; only absent
            health/environment modules produce clearly labelled simulated data.

    config SAFETY_BAND_POWER_MANAGEMENT
        bool "Enable automatic light sleep and dynamic CPU frequency"
        default y
        help
            Enables ESP32-S3 automatic light sleep whenever all application
            tasks are blocked. Modem transactions hold a power-management lock
            so UART communication is never interrupted. Requires CONFIG_PM_ENABLE
            and CONFIG_FREERTOS_USE_TICKLESS_IDLE.

    config SAFETY_BAND_PM_MIN_FREQ_MHZ
        int "Minimum idle CPU frequency (MHz)"
        depends on SAFETY_BAND_POWER_MANAGEMENT
        range 10 160
        default 40
        help
            CPU frequency used while no power-management locks are held.
            40 MHz provides a conservative balance between battery life and
            wake-up responsiveness for the SOS workflow.

    config SAFETY_BAND_GNSS_POWER_SAVE
        bool "Turn GNSS off between location requests"
        default y
        help
            Powers the SIM868 GNSS engine on only when a GPS fix is requested
            and turns it off after modem work completes. This saves battery but
            can make the next GPS fix slower than continuous GNSS operation.

    config SAFETY_BAND_EMERGENCY_CALL_NUMBER
        string "Emergency call number"
        default "+916309538622"
        help
            Phone number to dial when an SOS emergency is activated.

    config SAFETY_BAND_EMERGENCY_SMS_NUMBER
        string "Emergency SMS number(s)"
        default "+917288973229"
        help
            Recipient number for SOS SMS alerts. Separate multiple numbers with
            commas or semicolons.

    config SAFETY_BAND_GPRS_APN
        string "GPRS APN"
        default "iot.com"
        help
            APN supplied by the SIM provider. The GeoLinker reference SIM uses iot.com.

    config SAFETY_BAND_GEOLINKER_API_KEY
        string "GeoLinker API key"
        default ""
        help
            API key created in the CircuitDigest Cloud GeoLinker dashboard.

    config SAFETY_BAND_GEOLINKER_DEVICE_ID
        string "GeoLinker device ID"
        default "smart_safety_band"
        help
            Device identifier shown in the GeoLinker dashboard.

endmenu
